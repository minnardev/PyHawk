# 🦅 Hawk Math Demo
# Неявное умножение, математические формулы и функции

print "=== 🦅 Математика Hawk на лету ==="

# 1. Формула площади круга с неявным умножением 'pi r^2'
set r = 5
set S = pi r^2
print "Радиус:", r
print "Площадь круга S = pi r^2:", S

# 2. Неявное умножение в функции: 2x + 1
fn f(x) {
    return 2x + 1
}

set val = f(10)
print "f(x) = 2x + 1 при x=10:", val

# 3. Проверка равенства через '='
if (r = 5) {
    print "Условие (r = 5) сработало: r равно пяти!"
}

# 4. Цепочка сравнений 1 < r < 10
if (1 < r < 10) {
    print "r находится строго между 1 и 10!"
}

# 5. Цикл while
set count = 3
print "Обратный отсчёт:"
while (count > 0) {
    print count
    set count = count - 1
}
print "Полетели! 🦅"
