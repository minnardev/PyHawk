# 🦅 Hawk Matrix Demo
# Демонстрация синтаксиса матриц в стиле MATLAB

print "=== 🦅 Демонстрация матриц в Hawk ==="

# 1. Создание матрицы 2x2 (';' разделяет строки)
set A = [1, 2 ; 3, 4]
print "Матрица A:"
print A

# 2. Создание второй матрицы
set B = [2, 0 ; 1, 2]
print "Матрица B:"
print B

# 3. Матричное умножение
set C = A * B
print "Матричное произведение A * B:"
print C

# 4. Транспонирование через штрих '
set At = A'
print "Транспонированная A':"
print At

# 5. Определитель матрицы
print "Определитель det(A):", det(A)

# 6. Умножение на скаляр
set scaled = A * 10
print "A * 10:"
print scaled
