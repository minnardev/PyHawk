# 🦅 Strings Library Demo
# Demonstrates string manipulation with the strings.hwk stdlib.

import strings

set text = "  Hello, Hawk!  "

# Case conversion
print "Original:", text
print "Upper:", to_upper(text)
print "Lower:", to_lower(text)
print "Capitalize:", capitalize("hello world")

# Trimming
print "\nTrimmed:", trim(text)
print "Trim left:", trim_left(text)
print "Trim right:", trim_right(text)

# Search
print "\n--- Search ---"
print "contains 'Hawk':", contains(text, "Hawk")
print "contains 'xyz':", contains(text, "xyz")
print "starts_with '  H':", starts_with(text, "  H")
print "ends_with '!  ':", ends_with(text, "!  ")
print "index_of 'Hawk':", index_of(text, "Hawk")
print "last_index_of 'l':", last_index_of(text, "l")

# Replace and slice
print "\n--- Manipulation ---"
print "replace:", replace(text, "Hawk", "World")
print "substring 3-8:", substring(text, 3, 8)
print "slice 3:", slice(text, 3)
print "slice_end 5:", slice_end(text, 5)
print "repeat:", repeat("ab", 3)
print "reverse:", reverse("Hawk")
print "pad_left:", pad_left("5", 4, "0")
print "pad_right:", pad_right("5", 4, "0")

# Split & join
print "\n--- Split & Join ---"
set parts = split("a,b,c", ",")
print "split:", parts
print "join:", join("a|b|c", "-")
print "lines:", lines("line1\nline2\nline3")

# Utilities
print "\n--- Utilities ---"
print "length:", length(text)
print "is_empty '':", is_empty("")
print "is_empty 'x':", is_empty("x")
print "is_numeric '42':", is_numeric("42")
print "is_numeric 'abc':", is_numeric("abc")
