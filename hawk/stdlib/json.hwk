# json.hwk — Hawk Standard Library: JSON
# Built-ins cover all common JSON operations.
# File I/O uses built-in file functions.
# No external dependencies.
#
# Usage: import json
#
# All values that come from JSON are returned as strings.
# Use to_number() to convert numeric strings to numbers.
#
# Examples:
#   import json
#   set data = json.read_file("config.json")
#   print json.get(data, "name")
#   print json.get_nested(data, "user.profile.age")

# ==================== FILE I/O ====================

fn read_file(path) {
    return file_read(path)
}

fn write_file(path, json_str) {
    return file_write(path, json_str)
}

# ==================== PARSING & QUERYING ====================

fn parse(json_str) {
    return json_pretty(json_str)
}

fn get(json_str, key) {
    return json_get(json_str, key)
}

fn get_nested(json_str, path) {
    return json_get_nested(json_str, path)
}

fn keys(json_str) {
    return json_keys(json_str)
}

fn has_key(json_str, key) {
    return json_has_key(json_str, key)
}

fn type_of_value(json_str) {
    return json_type_of_value(json_str)
}

# ==================== BUILDING JSON ====================

fn stringify(value) {
    return json_stringify(value)
}

fn create_object(entries_str) {
    set pairs = split(entries_str, "|")
    set result = "{}"
    set i = 0
    set n = split_count(entries_str, "|")
    while (i < n) {
        set pair = split_get(entries_str, "|", i)
        if (contains(pair, ":")) {
            set parts = split(pair, ":")
            set k = split_get(parts, "|", 0)
            set v = split_get(parts, "|", 1)
            set result = json_set_key(result, k, v)
        }
        set i = i + 1
    }
    return result
}

fn create_array(items_str) {
    set result = "["
    set i = 0
    set n = split_count(items_str, "|")
    while (i < n) {
        set item = split_get(items_str, "|", i)
        if (i > 0) {
            set result = result + ","
        }
        if (is_numeric(item) = "true") {
            set result = result + item
        } else {
            set result = result + "\"" + item + "\""
        }
        set i = i + 1
    }
    set result = result + "]"
    return result
}

fn set_key(json_str, key, value) {
    return json_set_key(json_str, key, value)
}

fn delete_key(json_str, key) {
    return json_delete_key(json_str, key)
}

# ==================== FORMATTING ====================

fn pretty(json_str) {
    return json_pretty(json_str)
}

fn minify(json_str) {
    return json_minify(json_str)
}
