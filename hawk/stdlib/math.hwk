# math.hwk — Hawk Standard Library: Math
# Built-ins: sqrt, pow, floor, ceil, round, sin, cos, tan, asin, acos, atan, atan2, log, log10, log2, exp
# User functions below add the missing helpers.
#
# Usage: import math
#
# Examples:
#   set x = sqrt(16)
#   set y = pow(2, 10)
#   print round(3.7)

# ==================== BASIC MATH ====================

fn abs(x) {
    if (x < 0) {
        return -x
    }
    return x
}

fn sign(x) {
    if (x > 0) {
        return 1
    }
    if (x < 0) {
        return -1
    }
    return 0
}

fn max(a, b) {
    if (a > b) {
        return a
    }
    return b
}

fn min(a, b) {
    if (a < b) {
        return a
    }
    return b
}

fn clamp(x, lo, hi) {
    if (x < lo) {
        return lo
    }
    if (x > hi) {
        return hi
    }
    return x
}

# ==================== CONSTANTS ====================

fn pi() {
    return 3.141592653589793
}

fn e() {
    return 2.718281828459045
}

fn tau() {
    return 6.283185307179586
}

# ==================== UTILITIES ====================

fn factorial(n) {
    if (n <= 1) {
        return 1
    }
    set result = 1
    set i = 2
    while (i <= n) {
        set result = result * i
        set i = i + 1
    }
    return result
}

fn gcd(a, b) {
    while (b != 0) {
        set temp = b
        set b = a % b
        set a = temp
    }
    return a
}

fn lcm(a, b) {
    if (a = 0) {
        return 0
    }
    return abs(a * b) / gcd(a, b)
}
