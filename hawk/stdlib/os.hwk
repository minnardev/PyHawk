# os.hwk — Hawk Standard Library: OS
# Cross-platform OS interface for macOS, Linux, and Windows.
#
# Usage: import "os"
#
# All paths are strings. Paths with spaces are supported.
# File content is handled via a Python backend to safely
# process any characters (heredoc on Unix, argv on Windows).

# ==================== INTERNAL HELPERS ====================

fn _q(s) {
    return "\"" + s + "\""
}

fn _py(cmd) {
    set py = "python3"
    if (current_os() = "windows") {
        set py = "python"
    }
    return shell_output(py + " -c \"" + cmd + "\"")
}

fn _py1(cmd, a) {
    set py = "python3"
    if (current_os() = "windows") {
        set py = "python"
    }
    return shell_output(py + " -c \"" + cmd + "\" " + _q(a))
}

fn _py2(cmd, a, b) {
    set py = "python3"
    if (current_os() = "windows") {
        set py = "python"
    }
    return shell_output(py + " -c \"" + cmd + "\" " + _q(a) + " " + _q(b))
}

fn _ok(result) {
    if (result = 0) {
        return true
    }
    return false
}

# ==================== PLATFORM ====================

fn current_os() {
    return os_name()
}

fn is_macos() {
    return os_name() = "macos"
}

fn is_linux() {
    return os_name() = "linux"
}

fn is_windows() {
    return os_name() = "windows"
}

# ==================== PATH UTILITIES ====================

fn path_join(a, b) {
    return _py2("import os, sys; print(os.path.join(sys.argv[1], sys.argv[2]))", a, b)
}

fn path_dir(p) {
    return _py1("import os, sys; print(os.path.dirname(sys.argv[1]))", p)
}

fn path_file(p) {
    return _py1("import os, sys; print(os.path.basename(sys.argv[1]))", p)
}

fn path_stem(p) {
    return _py1("import os, sys; print(os.path.splitext(os.path.basename(sys.argv[1]))[0])", p)
}

fn path_ext(p) {
    return _py1("import os, sys; print(os.path.splitext(sys.argv[1])[1])", p)
}

fn path_abs(p) {
    return _py1("import os, sys; print(os.path.abspath(sys.argv[1]))", p)
}

fn path_norm(p) {
    return _py1("import os, sys; print(os.path.normpath(sys.argv[1]))", p)
}

# ==================== FILE OPERATIONS ====================

fn file_exists(path) {
    return _py1("import os, sys; print(os.path.exists(sys.argv[1]))", path) = "True"
}

fn file_is_file(path) {
    return _py1("import os, sys; print(os.path.isfile(sys.argv[1]))", path) = "True"
}

fn file_is_dir(path) {
    return _py1("import os, sys; print(os.path.isdir(sys.argv[1]))", path) = "True"
}

fn file_read(path) {
    if (current_os() = "windows") {
        return shell_output("python -c \"import sys; print(sys.stdin.read(), end='')\" < " + _q(path))
    }
    return shell_output("python3 -c \"import sys; print(sys.stdin.read(), end='')\" < " + _q(path))
}

fn file_read_lines(path) {
    return file_read(path)
}

fn file_write(path, content) {
    set py = "python3"
    if (current_os() = "windows") {
        set py = "python"
        return _ok(system(py + " -c \"import sys; open(sys.argv[1], 'w', newline='').write(sys.argv[2])\" " + _q(path) + " " + _q(content)))
    }
    return _ok(system(py + " -c \"import sys; open(sys.argv[1], 'w').write(sys.stdin.read())\" " + _q(path) + " <<'HAWK_OS_W'\n" + content + "\nHAWK_OS_W"))
}

fn file_append(path, content) {
    set py = "python3"
    if (current_os() = "windows") {
        set py = "python"
        return _ok(system(py + " -c \"import sys; open(sys.argv[1], 'a', newline='').write(sys.argv[2])\" " + _q(path) + " " + _q(content)))
    }
    return _ok(system(py + " -c \"import sys; open(sys.argv[1], 'a').write(sys.stdin.read())\" " + _q(path) + " <<'HAWK_OS_W'\n" + content + "\nHAWK_OS_W"))
}

fn file_delete(path) {
    if (current_os() = "windows") {
        return _ok(system("del /f /q " + _q(path)))
    }
    return _ok(system("rm -f " + _q(path)))
}

fn file_copy(src, dst) {
    if (current_os() = "windows") {
        return _ok(system("copy /y " + _q(src) + " " + _q(dst)))
    }
    return _ok(system("cp " + _q(src) + " " + _q(dst)))
}

fn file_move(src, dst) {
    if (current_os() = "windows") {
        return _ok(system("move /y " + _q(src) + " " + _q(dst)))
    }
    return _ok(system("mv " + _q(src) + " " + _q(dst)))
}

fn file_size(path) {
    return _py1("import os, sys; print(os.path.getsize(sys.argv[1]))", path)
}

# ==================== DIRECTORY OPERATIONS ====================

fn dir_exists(path) {
    return _py1("import os, sys; print(os.path.isdir(sys.argv[1]))", path) = "True"
}

fn dir_create(path) {
    set py = "python3"
    if (current_os() = "windows") {
        set py = "python"
    }
    return _ok(system(py + " -c \"import os, sys; os.makedirs(sys.argv[1], exist_ok=True)\" " + _q(path)))
}

fn dir_create_recursive(path) {
    return dir_create(path)
}

fn dir_delete(path) {
    if (current_os() = "windows") {
        return _ok(system("rmdir /s /q " + _q(path)))
    }
    return _ok(system("rm -rf " + _q(path)))
}

fn dir_list(path) {
    return _py1("import os, sys; print('\\n'.join(sorted(os.listdir(sys.argv[1]))))", path)
}

fn dir_list_files(path) {
    return _py1("import os, sys; p=sys.argv[1]; print('\\n'.join(sorted([f for f in os.listdir(p) if os.path.isfile(os.path.join(p, f))])))", path)
}

fn dir_list_dirs(path) {
    return _py1("import os, sys; p=sys.argv[1]; print('\\n'.join(sorted([f for f in os.listdir(p) if os.path.isdir(os.path.join(p, f))])))", path)
}

# ==================== NAVIGATION ====================

fn get_cwd() {
    return _py("import os; print(os.getcwd())")
}

# chdir is a built-in core function, available globally without import.

fn get_home() {
    return _py("import os; print(os.path.expanduser('~'))")
}

# ==================== PROCESSES ====================

fn exec(cmd) {
    return system(cmd)
}

fn exec_bg(cmd) {
    if (current_os() = "windows") {
        return system("start /b " + cmd)
    }
    return system(cmd + " &")
}

fn sleep(seconds) {
    if (current_os() = "windows") {
        return system("timeout /t " + seconds + " /nobreak > nul")
    }
    return system("sleep " + seconds)
}

fn kill_pid(pid) {
    if (current_os() = "windows") {
        return system("taskkill /f /pid " + pid)
    }
    return system("kill " + pid)
}

fn process_list() {
    if (current_os() = "windows") {
        return shell_output("tasklist")
    }
    return shell_output("ps aux")
}

# ==================== OPEN FILES & URLS ====================

fn open_file(path) {
    if (current_os() = "macos") {
        return system("open " + _q(path))
    }
    if (current_os() = "windows") {
        return system("start \"\" " + _q(path))
    }
    return system("xdg-open " + _q(path) + " &")
}

fn open_url(url) {
    if (current_os() = "macos") {
        return system("open " + _q(url))
    }
    if (current_os() = "windows") {
        return system("start \"\" " + _q(url))
    }
    return system("xdg-open " + _q(url) + " &")
}
