# os.hwk — Hawk Standard Library: OS
# Cross-platform OS interface using built-ins.
# No Python or shell_command dependencies.
#
# Usage: import "os"
#
# All paths are strings.

# ==================== PLATFORM ====================

fn current_os() {
    return os_name()
}

fn is_macos() {
    if (os_name() = "macos") {
        return true
    }
    return false
}

fn is_linux() {
    if (os_name() = "linux") {
        return true
    }
    return false
}

fn is_windows() {
    if (os_name() = "windows") {
        return true
    }
    return false
}

# ==================== PATH UTILITIES ====================

fn path_join(a, b) {
    if (is_macos() = "true" or is_linux() = "true") {
        return a + "/" + b
    }
    return a + "\\" + b
}

fn path_dir(p) {
    set parts = split(p, "/")
    if (is_windows() = "true") {
        set parts = split(p, "\\")
    }
    set n = length(parts)
    if (n = 0) {
        return ""
    }
    return substring(parts, 0, n - 1)
}

fn path_file(p) {
    if (is_macos() = "true" or is_linux() = "true") {
        set idx = last_index_of(p, "/")
    } else {
        set idx = last_index_of(p, "\\")
    }
    if (idx = "-1") {
        return p
    }
    return slice(p, idx + 1)
}

fn path_stem(p) {
    set f = path_file(p)
    set dot = last_index_of(f, ".")
    if (dot = "-1" or dot = 0) {
        return f
    }
    return slice(f, 0, dot)
}

fn path_ext(p) {
    set f = path_file(p)
    set dot = last_index_of(f, ".")
    if (dot = "-1" or dot = 0) {
        return ""
    }
    return slice(f, dot, length(f))
}

fn path_abs(p) {
    if (starts_with(p, "/") = "true" or starts_with(p, "\\") = "true") {
        return p
    }
    return get_cwd() + "/" + p
}

fn path_norm(p) {
    set result = ""
    set i = 0
    set parts = split(p, "/")
    set n = length(parts)
    while (i < n) {
        set part = substring(parts, i, i + 1)
        if (part = "..") {
            set result = path_dir(result)
        } else {
            if (result = "") {
                set result = part
            } else {
                set result = result + "/" + part
            }
        }
        set i = i + 1
    }
    return result
}

# ==================== FILE OPERATIONS ====================

fn file_exists(path) {
    return file_exists(path)
}

fn file_is_file(path) {
    return file_is_file(path)
}

fn file_is_dir(path) {
    return file_is_dir(path)
}

fn file_read(path) {
    return file_read(path)
}

fn file_read_lines(path) {
    return file_read(path)
}

fn file_write(path, content) {
    return file_write(path, content)
}

fn file_append(path, content) {
    return file_append(path, content)
}

fn file_delete(path) {
    return file_delete(path)
}

fn file_copy(src, dst) {
    set content = file_read(src)
    return file_write(dst, content)
}

fn file_move(src, dst) {
    set result = file_copy(src, dst)
    if (result = "true") {
        return file_delete(src)
    }
    return "false"
}

fn file_size(path) {
    return file_size(path)
}

# ==================== DIRECTORY OPERATIONS ====================

fn dir_exists(path) {
    return file_is_dir(path)
}

fn dir_create(path) {
    return dir_create(path)
}

fn dir_create_recursive(path) {
    return dir_create(path)
}

fn dir_delete(path) {
    return dir_delete(path)
}

fn dir_list(path) {
    return dir_list(path)
}

fn dir_list_files(path) {
    set items = split(dir_list(path), "|")
    set result = ""
    set i = 0
    set n = length(items)
    while (i < n) {
        set item = substring(items, i, i + 1)
        if (file_is_file(path + "/" + item) = "true") {
            if (result = "") {
                set result = item
            } else {
                set result = result + "|" + item
            }
        }
        set i = i + 1
    }
    return result
}

fn dir_list_dirs(path) {
    set items = split(dir_list(path), "|")
    set result = ""
    set i = 0
    set n = length(items)
    while (i < n) {
        set item = substring(items, i, i + 1)
        if (file_is_dir(path + "/" + item) = "true") {
            if (result = "") {
                set result = item
            } else {
                set result = result + "|" + item
            }
        }
        set i = i + 1
    }
    return result
}

# ==================== NAVIGATION ====================

fn get_cwd() {
    return get_cwd()
}

# chdir is a built-in core function, available globally without import.

fn get_home() {
    return get_home()
}

# ==================== PROCESSES ====================

fn exec(cmd) {
    return system(cmd)
}

fn exec_bg(cmd) {
    if (is_windows() = "true") {
        return system("start /b " + cmd)
    }
    return system(cmd + " &")
}

fn sleep(seconds) {
    if (is_windows() = "true") {
        return system("timeout /t " + seconds + " /nobreak > nul")
    }
    return system("sleep " + seconds)
}

fn kill_pid(pid) {
    if (is_windows() = "true") {
        return system("taskkill /f /pid " + pid)
    }
    return system("kill " + pid)
}

fn process_list() {
    if (is_windows() = "true") {
        return shell_output("tasklist")
    }
    return shell_output("ps aux")
}

# ==================== OPEN FILES & URLS ====================

fn open_file(path) {
    if (is_macos() = "true") {
        return system("open " + path)
    }
    if (is_windows() = "true") {
        return system("start \"\" " + path)
    }
    return system("xdg-open " + path + " &")
}

fn open_url(url) {
    if (is_macos() = "true") {
        return system("open " + url)
    }
    if (is_windows() = "true") {
        return system("start \"\" " + url)
    }
    return system("xdg-open " + url + " &")
}
