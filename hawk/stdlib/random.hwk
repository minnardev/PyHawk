# random.hwk — Hawk Standard Library: Random Numbers
# Built-ins: rand_float, rand_int, seed
# No external dependencies.
#
# Usage: import random
#
# Examples:
#   set n = rand_int(1, 100)
#   set f = rand_float()

fn rand_float() {
    return rand_float()
}

fn rand_int(lo, hi) {
    return rand_int(lo, hi)
}

fn seed(s) {
    return seed(s)
}

fn rand_float_range(lo, hi) {
    return rand_float() * (hi - lo) + lo
}

fn rand_int_range(lo, hi) {
    return rand_int(lo, hi)
}
