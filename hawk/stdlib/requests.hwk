# requests.hwk — HTTP-запросы
# Uses built-in HTTP functions. No external dependencies.
#
# Usage: import requests
#
# All methods return the response body as a string.
# status_code() extracts HTTP code from the first line.

# ==================== HTTP ====================

fn get(url) {
    return http_get(url)
}

fn post(url, data) {
    return http_post(url, data)
}

fn post_headers(url, data, headers_json) {
    return http_post(url, data, headers_json)
}

fn put(url, data) {
    return http_post(url, data)
}

fn delete(url) {
    return http_get(url)
}

fn patch(url, data) {
    return http_post(url, data)
}

fn download(url, path) {
    return http_download(url, path)
}

fn status_code(resp_text) {
    set line = ""
    set i = 0
    set n = length(resp_text)
    while (i < n) {
        set ch = substring(resp_text, i, i + 1)
        if (ch = "\n") {
            break
        }
        set line = line + ch
        set i = i + 1
    }
    set parts = split(line, " ")
    if (length(parts) >= 2) {
        return substring(parts, 1, 2)
    }
    return "0"
}
