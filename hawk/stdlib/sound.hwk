# sound.hwk — Hawk Standard Library: Sound
# Cross-platform audio playback for macOS, Linux, and Windows.
#
# Usage: import sound
#
# Functions:
#   play(file)    — play an audio file in the background
#   alert()       — system bell signal
#   sound_beep()  — alias for alert()

fn play(file) {
    # Play an audio file in the background (non-blocking)
    set os = os_name()
    if (os = "macos") {
        system("afplay \"" + file + "\" &")
    }
    if (os = "linux") {
        system("(paplay \"" + file + "\" 2>/dev/null || aplay \"" + file + "\" 2>/dev/null || play \"" + file + "\" 2>/dev/null) &")
    }
    if (os = "windows") {
        system("powershell -NoProfile -Command \"(New-Object Media.SoundPlayer '" + file + "').PlaySync()\"")
    }
}

fn alert() {
    # System bell signal
    beep()
}

fn sound_beep() {
    # Alias for alert()
    beep()
}
