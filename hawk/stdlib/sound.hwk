# sound.hwk — Hawk Standard Library: Sound
# Cross-platform audio playback for macOS, Linux, and Windows.
#
# Usage: import sound
#
# Functions:
#   play(file)    — play an audio file in the background
#
# Note: beep() is a built-in core function, available globally.
#       play_sound(path) is also built-in; sound.play() is kept
#       for backward compatibility and delegates to play_sound().

fn play(file) {
    play_sound(file)
}
