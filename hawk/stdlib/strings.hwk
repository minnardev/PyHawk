# strings.hwk — Hawk Standard Library: String Utilities
# Built-ins cover all common string operations.
# Cross-platform, no external dependencies.
#
# Usage: import strings
#
# All functions take and return strings (except length() which returns a number).
# Examples:
#   print strings.to_upper("hello")
#   print strings.split("a,b,c", ",")
#   print strings.trim("  text  ")

# ==================== CASE & TRIM ====================

fn to_upper(s) {
    return to_upper(s)
}

fn to_lower(s) {
    return to_lower(s)
}

fn capitalize(s) {
    return capitalize(s)
}

fn trim(s) {
    return trim(s)
}

fn trim_left(s) {
    return trim_left(s)
}

fn trim_right(s) {
    return trim_right(s)
}

# ==================== SEARCH ====================

fn contains(text, sub) {
    return contains(text, sub)
}

fn starts_with(text, prefix) {
    return starts_with(text, prefix)
}

fn ends_with(text, suffix) {
    return ends_with(text, suffix)
}

fn index_of(text, sub) {
    return index_of(text, sub)
}

fn last_index_of(text, sub) {
    return last_index_of(text, sub)
}

# ==================== MANIPULATION ====================

fn replace(text, old, new) {
    return replace(text, old, new)
}

fn substring(text, start, end) {
    return substring(text, start, end)
}

fn repeat(text, count) {
    return repeat(text, count)
}

fn reverse(s) {
    return reverse(s)
}

fn pad_left(text, width, pad_char) {
    return pad_left(text, width, pad_char)
}

fn pad_right(text, width, pad_char) {
    return pad_right(text, width, pad_char)
}

# ==================== SPLIT & JOIN ====================

fn split(text, sep) {
    return split(text, sep)
}

fn join(parts, sep) {
    return join(parts, sep)
}

fn lines(text) {
    return lines(text)
}

# ==================== UTILITIES ====================

fn length(s) {
    return length(s)
}

fn is_empty(s) {
    return is_empty(s)
}

fn is_numeric(s) {
    return is_numeric(s)
}

fn slice(text, start) {
    return slice(text, start)
}

fn slice_end(text, end) {
    return slice_end(text, end)
}
