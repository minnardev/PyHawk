# time.hwk — Hawk Standard Library: Time & Date
# Cross-platform. All functions use a Python backend so
# formatting is stable regardless of system locale.
#
# Usage: import time
#
# Example:
#   set t = now()
#   print t          # 2026-09-08 22:03:16
#   set ts = timestamp()  # 1788885830 (number)

# ==================== INTERNAL HELPERS ====================

fn _py(cmd) {
    set py = "python3"
    if (os_name() = "windows") {
        set py = "python"
    }
    return shell_output(py + " -c \"" + cmd + "\"")
}

# ==================== DATE & TIME ====================

fn now() {
    return _py("import datetime; print(datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'))")
}

fn today() {
    return _py("import datetime; print(datetime.date.today().isoformat())")
}

fn clock() {
    return _py("import datetime; print(datetime.datetime.now().strftime('%H:%M:%S'))")
}

fn timestamp() {
    return to_number(_py("import time; print(int(time.time()))"))
}

fn day_of_week() {
    return _py("import datetime; print(datetime.datetime.now().strftime('%A'))")
}

fn month() {
    return _py("import datetime; print(datetime.datetime.now().strftime('%B'))")
}

fn year() {
    return _py("import datetime; print(datetime.datetime.now().strftime('%Y'))")
}

fn hour() {
    return _py("import datetime; print(datetime.datetime.now().strftime('%H'))")
}

fn minute() {
    return _py("import datetime; print(datetime.datetime.now().strftime('%M'))")
}

# ==================== SLEEP ====================
# Renamed to sleep_seconds to avoid shadowing the built-in sleep()

fn sleep_seconds(seconds) {
    if (os_name() = "windows") {
        return system("timeout /t " + seconds + " /nobreak > nul")
    }
    return system("sleep " + seconds)
}
