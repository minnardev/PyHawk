# time.hwk — Hawk Standard Library: Time & Date
# Cross-platform. Functions RETURN strings (can be stored in variables).
#
# Usage: import time
#
# Example:
#   set t = now()
#   print t          # 2026-09-08 22:03:16

# ==================== DATE & TIME (return values) ====================

fn now() {
    # Return current date and time as string: "2026-09-08 22:03:16"
    if (os_name() = "windows") {
        return shell_output("powershell -NoProfile -Command \"Get-Date -Format 'yyyy-MM-dd HH:mm:ss'\"")
    }
    return shell_output("date '+%Y-%m-%d %H:%M:%S'")
}

fn today() {
    # Return current date as string: "2026-09-08"
    if (os_name() = "windows") {
        return shell_output("powershell -NoProfile -Command \"Get-Date -Format 'yyyy-MM-dd'\"")
    }
    return shell_output("date '+%Y-%m-%d'")
}

fn clock() {
    # Return current time as string: "22:03:16"
    if (os_name() = "windows") {
        return shell_output("powershell -NoProfile -Command \"Get-Date -Format 'HH:mm:ss'\"")
    }
    return shell_output("date '+%H:%M:%S'")
}

fn timestamp() {
    # Return Unix timestamp as string: "1788885830"
    if (os_name() = "windows") {
        return shell_output("powershell -NoProfile -Command \"[int][double]::Parse((Get-Date -UFormat %s))\"")
    }
    return shell_output("date +%s")
}

fn day_of_week() {
    # Return current day name: "Monday", "Tuesday", ...
    if (os_name() = "windows") {
        return shell_output("powershell -NoProfile -Command \"(Get-Date).DayOfWeek.ToString()\"")
    }
    return shell_output("date '+%A'")
}

fn month() {
    # Return current month name: "January", "September", ...
    if (os_name() = "windows") {
        return shell_output("powershell -NoProfile -Command \"(Get-Date).ToString('MMMM')\"")
    }
    return shell_output("date '+%B'")
}

fn year() {
    # Return current year as string: "2026"
    if (os_name() = "windows") {
        return shell_output("powershell -NoProfile -Command \"(Get-Date).Year\"")
    }
    return shell_output("date '+%Y'")
}

fn hour() {
    # Return current hour: "22"
    if (os_name() = "windows") {
        return shell_output("powershell -NoProfile -Command \"(Get-Date).Hour\"")
    }
    return shell_output("date '+%H'")
}

fn minute() {
    # Return current minute: "03"
    if (os_name() = "windows") {
        return shell_output("powershell -NoProfile -Command \"(Get-Date).Minute\"")
    }
    return shell_output("date '+%M'")
}

# ==================== SLEEP ====================

fn sleep(seconds) {
    # Pause execution for the given number of seconds
    if (os_name() = "windows") {
        system("timeout /t " + seconds + " /nobreak > nul")
    }
    system("sleep " + seconds)
}
