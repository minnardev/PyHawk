# time.hwk — Hawk Standard Library: Time & Date
# Built-ins: timestamp, now, today, clock, day_of_week, month, year, hour, minute
# Cross-platform. All functions use built-ins so there is no
# dependency on Python or shell commands.
#
# Usage: import time
#
# Example:
#   set t = now()
#   print t          # 2026-09-08 22:03:16
#   set ts = timestamp()  # 1788885830 (number)

# ==================== DATE & TIME ====================

fn now() {
    return now()
}

fn today() {
    return today()
}

fn clock() {
    return clock()
}

fn timestamp() {
    return timestamp()
}

fn day_of_week() {
    return day_of_week()
}

fn month() {
    return month()
}

fn year() {
    return year()
}

fn hour() {
    return hour()
}

fn minute() {
    return minute()
}

# ==================== SLEEP ====================
# Renamed to sleep_seconds to avoid shadowing the built-in sleep()

fn sleep_seconds(seconds) {
    if (os_name() = "windows") {
        return system("timeout /t " + seconds + " /nobreak > nul")
    }
    return system("sleep " + seconds)
}
