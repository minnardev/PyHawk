{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Hawk",
  "scopeName": "source.hawk",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#matrices"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.hawk",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.hawk",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.hawk",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.hawk",
          "match": "\\\\."
        },
        {
          "name": "variable.other.interpolated.hawk",
          "match": "\\{[^}]+\\}"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.hawk",
          "match": "\\b(set|print|fn|return|if|else|while|for|import)\\b"
        },
        {
          "name": "keyword.operator.logical.hawk",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "types": {
      "name": "entity.name.type.hawk",
      "match": "\\b(int|float|double|string|Matrix|bool)\\b"
    },
    "constants": {
      "name": "constant.language.hawk",
      "match": "\\b(pi|e|true|false)\\b"
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.hawk",
          "match": "\\b(det|sin|cos|tan|sqrt|abs|exp|log|round|floor|ceil|input)\\b"
        },
        {
          "match": "\\bfn\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.function.hawk"
            }
          }
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.hawk",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.hawk",
          "match": "(!=|=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.hawk",
          "match": "(\\+|-|\\*|/|\\^|')"
        }
      ]
    },
    "matrices": {
      "patterns": [
        {
          "name": "punctuation.separator.matrix.hawk",
          "match": ";"
        }
      ]
    }
  }
}